{
  "manifest_version": 3,
  "name": "CuePoint — YouTube Timestamp Bookmarks",
  "version": "1.1.4",
  "author": "Nitish Poonia",
  "description": "Save exact YouTube video timestamps with notes, search your moments, and optionally sync live across devices via your own Firebase.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/cuepoint-16.png",
    "32": "icons/cuepoint-32.png",
    "48": "icons/cuepoint-48.png",
    "128": "icons/cuepoint-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://*.firebasedatabase.app/*"
  ],
  "action": {
    "default_title": "CuePoint",
    "default_icon": {
      "16": "icons/cuepoint-16.png",
      "32": "icons/cuepoint-32.png",
      "48": "icons/cuepoint-48.png",
      "128": "icons/cuepoint-128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/schema.js",
        "src/shared/messages.js",
        "src/content/mobile-dom.js",
        "src/content/dom.js",
        "src/content/popover.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
