{
  "manifest_version": 3,
  "name": "CuePoint — YouTube Timestamp Bookmarks",
  "version": "1.1.4",
  "author": "Nitish Poonia",
  "description": "Save exact YouTube video timestamps with notes, search your moments, and optionally sync live across devices via your own Firebase.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cuepoint@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "authenticationInfo",
          "browsingActivity",
          "personalCommunications",
          "personallyIdentifyingInfo",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "32": "icons/cuepoint.svg",
    "48": "icons/cuepoint.svg",
    "64": "icons/cuepoint.svg",
    "96": "icons/cuepoint.svg",
    "128": "icons/cuepoint.svg"
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://*.firebasedatabase.app/*"
  ],
  "action": {
    "default_title": "CuePoint",
    "default_area": "navbar",
    "default_icon": "icons/cuepoint.svg"
  },
  "background": {
    "scripts": [
      "src/shared/platform.js",
      "src/shared/schema.js",
      "src/shared/messages.js",
      "src/shared/cloud-consent.js",
      "src/storage/local-repo.js",
      "src/storage/firebase-auth.js",
      "src/storage/firebase-rtdb.js",
      "src/background/queue.js",
      "src/background/sync-model.js",
      "src/background/sync-manager.js",
      "src/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/shared/schema.js",
        "src/shared/messages.js",
        "src/content/mobile-dom.js",
        "src/content/dom.js",
        "src/content/popover.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
