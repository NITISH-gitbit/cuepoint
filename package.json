{
  "name": "cuepoint",
  "version": "1.1.3",
  "private": true,
  "license": "MIT",
  "description": "Save exact YouTube video timestamps with notes, search your moments, and optionally sync live across devices via your own Firebase.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "web-ext lint --warnings-as-errors",
    "build": "web-ext build --overwrite-dest",
    "dev": "web-ext run"
  },
  "webExt": {
    "ignoreFiles": [
      "BRAND.md",
      "FIREBASE_SETUP.md",
      "README.md",
      "design/**",
      "screenshots/**",
      "release-instructions.md",
      "tests/**"
    ]
  },
  "devDependencies": {
    "web-ext": "^10.6.0"
  }
}
