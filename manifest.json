{
  "manifest_version": 3,
  "name": "CuePoint",
  "version": "1.1.3",
  "author": "Aaditya Joshi",
  "description": "Save exact YouTube video timestamps with notes, search your moments, and optionally sync live across devices via your own Firebase.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-moments@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://*.firebasedatabase.app/*"
  ],
  "action": {
    "default_title": "CuePoint",
    "default_area": "navbar",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "scripts": [
      "src/shared/schema.js",
      "src/shared/messages.js",
      "src/storage/local-repo.js",
      "src/storage/firebase-auth.js",
      "src/storage/firebase-rtdb.js",
      "src/background/queue.js",
      "src/background/sync-model.js",
      "src/background/sync-manager.js",
      "src/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "src/shared/schema.js",
        "src/shared/messages.js",
        "src/content/dom.js",
        "src/content/popover.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
